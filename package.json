{
  "name": "superview",
  "version": "0.3.1",
  "description": "Render AI output as beautiful, reviewable HTML with feedback and iteration",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "superview": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai",
    "html",
    "viewer",
    "feedback",
    "cli",
    "render",
    "markdown",
    "review"
  ],
  "author": "Pranit Garg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pranit-garg/superview.git"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
